{
  "name": "support-happytohelp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.8.1"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply happytohelp --local",
    "test": "node --test tests/*.test.mjs",
    "verify": "pnpm test:composition && pnpm validate:manifest && pnpm typecheck && pnpm test && pnpm test:browser && pnpm build",
    "setup:local": "node scripts/setup-local.mjs",
    "deploy": "node scripts/deploy.mjs",
    "test:browser": "node tests/browser-runtime.mjs",
    "setup": "node scripts/setup.mjs",
    "test:composition": "node scripts/test-composition.mjs --consumer",
    "validate:manifest": "node tools/seed-schema/validate.mjs --schema SEED seed.json"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.33",
    "@tanstack/react-start": "1.168.50",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  },
  "packageManager": "pnpm@10.12.4"
}
