{
  "name": "@run-edit-run/happytohelp",
  "version": "0.2.2-rc.1",
  "description": "Open-source customer support workspace: chat widget, team inbox, AI-assisted replies and help centers on Cloudflare Workers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/just-every/happytohelp"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.8.1"
  },
  "scripts": {
    "build": "node scripts/migrations.mjs && pnpm run build:assets && vite build",
    "build:assets": "node scripts/build-local-agent.cjs && pnpm run build:widget",
    "dev": "pnpm run build:assets && vite dev",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/operations.mjs describe && pnpm run build && pnpm run typecheck && pnpm run test:modules && pnpm run test:runtime && pnpm run test:journey && pnpm run source:check && node --test tests/independent-contract.mjs tests/homepage-source.mjs",
    "setup": "node scripts/setup.mjs",
    "deploy": "node scripts/deploy.mjs",
    "test:runtime": "node tests/runtime.mjs && node tests/security-headers-runtime.mjs && node tests/abuse-limits-runtime.mjs",
    "test:journey": "node tests/first-release-journey.mjs",
    "build:widget": "node scripts/build-widget.mjs",
    "source:inspect": "node scripts/edition-authoring/cli.mjs inspect",
    "source:check": "node scripts/edition-authoring/cli.mjs check",
    "source:lock": "node scripts/edition-authoring/cli.mjs lock",
    "source:release": "node scripts/edition-authoring/cli.mjs release",
    "migrations:prepare": "node scripts/migrations.mjs",
    "test:modules": "node scripts/verify-modules.mjs",
    "test:homepage-source": "node --test tests/homepage-source.mjs",
    "test:widget-browser": "node tests/widget-browser-runtime.mjs",
    "test:ui-browser": "node tests/ui-browser.mjs",
    "test:accessibility-browser": "node tests/accessibility-browser.mjs",
    "test:navigation-browser": "node tests/navigation-browser.mjs",
    "test:public-help-center-browser": "node tests/public-help-center-browser.mjs",
    "test:setup-browser": "node tests/setup-browser.mjs",
    "test:demo-inbox-browser": "node tests/demo-inbox-browser.mjs",
    "test:mobile-inbox-browser": "node tests/mobile-inbox-browser.mjs",
    "test:conversation-panel-resize-browser": "node tests/conversation-panel-resize-browser.mjs",
    "verify:visual": "node scripts/verify-visual-edit.mjs",
    "install:app": "node scripts/install.mjs",
    "test:widget-lifecycle-browser": "node tests/widget-lifecycle-browser.mjs",
    "test:independent-runtime": "node tests/independent-runtime.mjs",
    "test:reproducible-build": "node --test tests/reproducible-build.mjs",
    "test:contact-erasure-browser": "node tests/contact-erasure-browser.mjs",
    "test:delegation": "node --test tests/delegation-sqlite.mjs && python3 tests/delegation-backup.py && node tests/delegation-runtime.mjs",
    "test:delegation-authority-runtime": "node tests/delegation-authority-runtime.mjs",
    "test:delegation-scoped-browser": "node tests/delegation-scoped-browser.mjs",
    "test:usage": "pnpm run migrations:prepare && node --test tests/usage-summary.mjs tests/usage-limits.mjs",
    "test:delegation-browser": "node tests/delegation-browser.mjs",
    "test:computers-delegation-browser": "node tests/computers-delegation-browser.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.111.0",
    "@floating-ui/react": "^0.26.22",
    "@fortawesome/fontawesome-svg-core": "^6.7.1",
    "@fortawesome/free-solid-svg-icons": "^6.7.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@google/genai": "2.11.0",
    "@tanstack/react-router": "1.170.33",
    "@tanstack/react-start": "1.168.50",
    "autosize": "^6.0.1",
    "bootstrap": "^5.3.3",
    "classnames": "^2.5.1",
    "css-color-names": "^1.0.1",
    "date-fns": "^2.30.0",
    "feather-icons": "4.29.2",
    "h2h-widget-external-links": "npm:remark-external-links@^9.0.1",
    "h2h-widget-gfm": "npm:remark-gfm@^4.0.0",
    "h2h-widget-markdown": "npm:react-markdown@^9.0.1",
    "highlight.js": "^10.7.3",
    "hono": "4.13.7",
    "html-to-text": "10.0.1",
    "i18n-iso-countries": "^6.3.0",
    "initials": "^3.1.1",
    "khroma": "^1.4.1",
    "moment": "^2.29.1",
    "moment-timezone": "^0.5.33",
    "object-merge-advanced": "^14.0.18",
    "openai": "6.46.0",
    "postal-mime": "3.0.0",
    "pretty-bytes": "^5.5.0",
    "prop-types": "^15.7.2",
    "react": "19.2.8",
    "react-bootstrap": "^2.10.6",
    "react-cool-onclickoutside": "^1.5.9",
    "react-dom": "19.2.8",
    "react-dropzone": "^14.3.5",
    "react-hook-form": "^7.45.2",
    "react-infinite-scroll-hook": "^4.0.1",
    "react-markdown": "^6.0.2",
    "react-scroll-to-bottom": "^4.0.0",
    "react-shadow": "^20.5.0",
    "react-textarea-autosize": "^8.3.2",
    "react-timeago": "^7.1.0",
    "react-tooltip": "^5.28.0",
    "remark-external-links": "^8.0.0",
    "remark-gfm": "^1.0.0",
    "turndown": "^7.2.0",
    "ua-parser-js": "1.0.41",
    "use-file-input": "^1.0.0",
    "use-window-focus": "^1.3.0",
    "uuid": "14.0.1",
    "ws": "8.21.0",
    "zod": "3.24.2",
    "zod-to-json-schema": "3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "esbuild": "0.28.1",
    "playwright": "1.63.0-alpha-2026-08-31",
    "sass": "^1.93.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.4"
    }
  }
}
