{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "support-happytohelp",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "happytohelp",
      "database_id": "local-happytohelp",
      "migrations_dir": "migrations"
    }
  ]
}
